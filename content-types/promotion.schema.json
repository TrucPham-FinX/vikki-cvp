{
  "$id": "cvp:promotion",
  "title": "Promotion Item",
  "description": "Schema for Promotion collection item",
  "type": "object",
  "required": ["id", "name"],
  "properties": {
    "id": { "type": "string", "pattern": "^promo-\\d{3}$" },
    "promotionGroup": { "type": "string" },
    "promotionCate": { "type": "string" },
    "promotionCode": { "type": "string" },
    "name": { "type": "string" },
    "thumbnail": { "type": "string" },
    "shortDesc": { "type": "string" },
    "longDesc": { "type": "string" },
    "startDate": { "type": "string" },
    "endDate": { "type": "string" },
    "createdDate": { "type": "string" },
    "updatedDate": { "type": "string" },
    "isHotDeal": { "type": "boolean" },
    "extraData": { "type": ["string", "object"] }
  },
  "additionalProperties": true
}

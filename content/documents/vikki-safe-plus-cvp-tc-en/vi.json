        {
          "id": "exclusions",
          "title": "Exclusions",
          "expanded": false,
          "blocks": [
            {
              "type": "paragraph",
              "text": "Key exclusions:"
            },
            {
              "type": "list",
              "style": "disc",
              "items": [
                {
                  "text": "Intentional acts of the insured, the insurance buyer or the beneficiary (only excluding beneficiaries who commit violations);"
                },
                {
                  "text": "The insured person violates the law on the following acts: Illegal racing; Driving a vehicle without a Driver’s License/or an invalid Driver’s License; Entering prohibited roads or restricted areas; Going in the opposite direction on a one-way street, going in the opposite direction on a road with a “Prohibited” sign; Not staying in the correct lane or designated part of the road."
                },
                {
                  "text": "The insured person uses alcohol or beer in excess of the concentration prescribed by the Road Traffic Law."
                },
                {
                  "text": "The insured person uses drugs or other stimulants."
                },
                {
                  "text": "The insured person dies suddenly or of unknown cause or dies without being able to determine the cause of death for any reason."
                }
              ]
            },
            {
              "type": "paragraph",
              "className": "legal-note",
              "text": "<em>Other exclusions are specifically specified in the Insurance Wording.</em>"
            },
            {
              "type": "paragraph",
              "className": "bold",
              "text": "To view further information about this insurance product, please refer to <a href=\"insurance-wording.html\" style=\"color: #0047ff;\">Accident insurance wordings.</a>"

          "id": "the-insured",
          "title": "The Insured",
          "expanded": false,
          "blocks": [
            {
              "type": "paragraph",
              "text": "Vietnamese citizens and foreigners living, studying, working, and working in Vietnam and are between the ages of 18 years old and 75 years old. The insured does not fall into the following cases:"
            },
            {
              "type": "list",
              "style": "disc",
              "items": [
                {
                  "text": "Persons with a history of or currently suffering from mental illness, neurological disorders, or leprosy."
                },
                {
                  "text": "Persons with disability or permanent impairment of 50% or more."
                }
              ]
            }
          ],
          "sections": []
        },
        {
          "id": "benefits-and-coverage",
          "title": "Benefits and coverage",
          "expanded": false,
          "blocks": [
            {
              "type": "list",
              "style": "disc",
              "items": [
                {
                  "text": "Sum insured: Please select an approriate plan as below."
                },
                {
                  "text": "Insurance period: Flexible based on customer request, up to a maximum of 12 months."
                },
                {
                  "text": "Beneficiary: Insured or nominated beneficiary."
                },
                {
                  "text": "Territory limit: Vietnam"
                },
                {
                  "text": "Waiting period: Not Applicable"
                },
                {
                  "text": "Insurance benefits:"
                }
              ]
            },
            {
              "type": "list",
              "style": "disc",
              "items": [
                {
                  "text": "Pay entire sum insured in case of death or total permanent disability;"
                },
                {
                  "text": "Pay compensation subject to List of Disability Ratio attached to policy wording for permanent partial disability;"
                },
                {
                  "text": "Pay medical expenses for temporary disability due to accident;"
                },
                {
                  "text": "Pay allowance during hospitalization for injuries caused by accidents."
                },
                {
                  "text": "Please kindly refer to detailed insurance benefits of each insurance plan."
                },
                {
                  "text": "Beneficiary: Insured or nominated beneficiary"
                }
              ]
            },
            {
              "type": "paragraph",
              "className": "legal-note",
              "text": "<em>Please refer to the policy breakdown for detailed coverage details of each plan.</em>"

<section class="product-list cols-{{ b.columns }}" id="{{ b.id }}">
<h2 class="section-title">{{ b.title }}</h2>
<ul class="product-grid">
{% for p in b.items %}<li class="{{ cx('product-card', 'is-hot' if p.isHotDeal) }}" data-id="{{ p.id }}">
<img class="product-thumb" src="{{ p.thumbnail }}" alt="{{ p.name }}" loading="lazy">
{% if p.isHotDeal %}<span class="badge badge-hot">{{ t('badge.hot') }}</span>{% endif %}
<h3 class="product-name">{{ p.name }}</h3>
<div class="product-desc">{{ p.shortDesc | safe }}</div>
<ul class="product-tags">{% for c in p.categories %}<li class="tag tag-{{ c | lower }}">{{ c }}</li>{% endfor %}</ul>
<span class="button" data-promo-id="{{ p.id }}">{{ t('products.cta') }}</span>
</li>{% endfor %}
</ul>
</section>

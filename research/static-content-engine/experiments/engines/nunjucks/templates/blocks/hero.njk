<section class="hero" id="banner-container">
<video class="hero-video" src="{{ asset(b.video.src) }}" poster="{{ asset(b.video.poster) }}" autoplay muted loop playsinline></video>
<div class="hero-text"><h1 class="hero-heading">{{ b.heading }}</h1><p class="hero-sub">{{ b.subheading }}</p></div>
</section>

<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<link rel="stylesheet" href="{{ 'css/base.css' | asset }}">
{% block head %}{% endblock %}
</head>
{%- if hasTopSpace %}{% assign top = 'hasTopSpace' %}{% else %}{% assign top = '' %}{% endif %}{% assign lang = 'lang-' | append: locale -%}
<body class="{{ top | cx: className, lang }}" id="body">
<header class="site-header"><img class="site-logo" src="{{ 'logo-vikki.png' | asset }}" alt="Vikki Digital Bank"></header>
{% block main %}{% endblock %}
<footer class="site-footer"><button type="button" id="backToTop" aria-label="{{ 'backToTop' | t }}"><img src="{{ 'icon-btt.svg' | asset }}" alt=""></button></footer>
<script src="{{ 'js/runtime.js' | asset }}" defer></script>
{% block scripts %}{% endblock %}
</body>
</html>

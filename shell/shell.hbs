<!DOCTYPE html>
<html lang="{{#if language}}{{language}}{{else}}{{#if htmlLanguage}}{{htmlLanguage}}{{else}}vi{{/if}}{{/if}}">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>{{title}}</title>
  {{> header}}
  {{#if themeCss}}
    <style>{{{themeCss}}}</style>
  {{/if}}
  {{#if pageCss}}
    <style>{{{pageCss}}}</style>
  {{/if}}
</head>

<body class="{{#if hasTopSpace}}hasTopSpace{{/if}}{{#if hasBackground}} hasBackground{{/if}}{{#if className}} {{className}}{{/if}}" id="body">
  {{{body}}}

  {{#if components}}
    {{#each components}}
      {{block this}}
    {{/each}}
  {{/if}}

  <span id="backToTop">
    <img src="{{assetPath 'icon-btt.svg'}}" alt="{{t 'backToTop'}}" />
  </span>

  {{> popup}}

  <template id="qaTemplate">
    <div class="popup-inner">
      <h2 class="popup-title" id="popupTitle">
        {{t 'faq.title'}}
      </h2>
      <div id="qaList"></div>
    </div>
  </template>

  {{> footer}}
  {{#if pageJs}}
    <script>{{{pageJs}}}</script>
  {{/if}}
</body>
</html>

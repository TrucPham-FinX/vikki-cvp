<script>
    function initAccordion(root, options = {}) {
      const { multiple = false, defaultOpenIndex = null } = options;

      const items = root.querySelectorAll('.accordion-item');

      items.forEach((item, index) => {
        const header = item.querySelector('.accordion-header');
        const content = item.querySelector('.accordion-content');

        header.addEventListener('click', () => {
          const isActive = item.classList.contains('active');

          if (!multiple) {
            items.forEach((i) => {
              i.classList.remove('active');
              i.querySelector('.accordion-content').style.maxHeight = null;
            });
          }

          if (!isActive) {
            item.classList.add('active');
            content.style.maxHeight = content.scrollHeight + 'px';
          } else {
            item.classList.remove('active');
            content.style.maxHeight = null;
          }
        });

        if (defaultOpenIndex === index) {
          item.classList.add('active');
          content.style.maxHeight = content.scrollHeight + 'px';
        }
      });
    }

    function initAccordionsIn(root) {
      root.querySelectorAll('.js-accordion').forEach((acc) => {
        initAccordion(acc);
      });
    }

    initAccordionsIn(document);
  </script>

{{!-- prettier-ignore --}}
<script>
    const popup = document.getElementById('popup');
    const popupBody = document.getElementById('popupBody');
    const closeBtn = document.getElementById('popupClose');
    const qaTemplate = document.getElementById('qaTemplate');
    const loading = document.getElementById('loading')
    const popupTitle = document.getElementById('popupTitle')

    document.querySelectorAll('[data-popup]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const type = btn.dataset.popup;
        const title = btn.dataset.title;
       
        openPopup(type, title);
      });
    });

    if(closeBtn){
      closeBtn.addEventListener('click', closePopup);
    }
    

    popup.addEventListener('click', (e) => {
      if (e.target === popup) closePopup();
    });

     function retryContent (type, iframe) {
        iframe.src = type;
        popupBody.appendChild(iframe);
       
        let timeout = setTimeout(() => {
          retryContent(type, iframe)
        }, 5000);

        iframe.onload = () => {
          loading.classList.remove('show');
          clearTimeout(timeout);
        };
    }

    function looksLikePdf(url) {
      return /\.pdf($|\?)/i.test(url);
    }

    // The page's ?lang (vi|en|ko, runtime/README.md) goes on with the CVP pages its popups open
    function withLang(url) {
      const lang = new URLSearchParams(window.location.search).get('lang');
      if (!lang || looksLikePdf(url)) return url;
      try {
        const target = new URL(url, window.location.href);
        if (target.origin !== window.location.origin || target.searchParams.has('lang')) return url;
        target.searchParams.set('lang', lang);
        return url.startsWith('/') ? target.pathname + target.search + target.hash : target.href;
      } catch (e) {
        return url;
      }
    }

    function openPopup(type, title) {
      popupBody.innerHTML = '';
      const isLink = type.startsWith('https://') || type.startsWith('/')
      const isPdfLink = looksLikePdf(type)
      if (isLink) type = withLang(type)

     // if(title){
         // popupTitle.textContent = title;
     // }

      if (!isLink) {
        popupBody.appendChild(qaTemplate.content.cloneNode(true));
        initAccordionsIn(popupBody);
        loading.classList.remove('show');
      } else {
        if(title){
          const titleEl = document.createElement('h2');
          titleEl.className = 'popup-title';
          titleEl.textContent = title;
          popupBody.appendChild(titleEl);
          popupBody.classList.add('pt-50')
        }

        const iframe = document.createElement('iframe');
        iframe.className = 'popup-iframe';
        if(isPdfLink){
          retryContent(type, iframe)
        } else {
          iframe.src = type;
          popupBody.appendChild(iframe);
         loading.classList.remove('show');
        }
        
      }
     
      popup.classList.add('show');
      document.body.style.overflow = 'hidden';
    }

    function closePopup() {
      loading.classList.add('show')
      popup.classList.remove('show');
      popupBody.innerHTML = '';
      document.body.style.overflow = '';
    }
  </script>


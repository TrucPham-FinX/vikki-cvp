<script>
  const popupDetail = document.getElementById('promo-detail-popup');
  const iframeDetail = document.getElementById('promo-detail-frame');
  const popupDetailClose = document.getElementById('popupDetail-close');

  window.addEventListener('message', (e) => {
    if (e.data?.type !== 'OPEN_PROMO_DETAIL') return;
    openPromoDetail(e.data.id);
  });

  function openPromoDetail(id) {
    iframeDetail.src = `/vikki-cvp/promotion/${id}.html`;
    popupDetail.classList.add('show');
    document.body.style.overflow = 'hidden';
  }

  if (popupDetailClose) {
    popupDetailClose.addEventListener('click', closePromoDetail);
  }

  function closePromoDetail() {
    iframeDetail.src = '';
    popupDetail.classList.remove('show');
    document.body.style.overflow = '';
  }
</script>
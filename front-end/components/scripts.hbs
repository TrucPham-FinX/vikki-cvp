<script type="text/javascript">
    const body = document.getElementById('body');
    const videoContainer = document.getElementById('banner-container');
    const video = document.getElementById('banner-video');
    const volumeIcon = document.getElementById('volume-icon');
    const params = new URLSearchParams(window.location.search);
    const hasTopSpace = params.get('hasTopSpace');

    if (hasTopSpace === 'false') {
      // body.style.paddingTop = '0';
      body.classList.remove('hasTopSpace');
    }
    
    if(videoContainer){
      const videoSrc = {{#if bannerVideoHlsSrc}}{{{json bannerVideoHlsSrc}}}{{else}}'./assets/video/playlist.m3u8'{{/if}};
      if (Hls.isSupported()) {
        var hls = new Hls();
        hls.loadSource(videoSrc);
        hls.attachMedia(video);
      } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
        video.src = videoSrc;
      } else {
        video.src = './assets/video.mp4';
      }

      video.addEventListener('loadedmetadata', () => {
        video.play().catch(() => {
          console.log('Autoplay blocked');
        });
      });

      // #video-container's height (see styles.hbs) is driven by --video-ar
      // instead of a hardcoded ratio, so it stays correct no matter which
      // video a given page loads.
      const videoBox = document.getElementById('video-container');
      const applyVideoRatio = () => {
        if (videoBox && video.videoWidth && video.videoHeight) {
          videoBox.style.setProperty('--video-ar', video.videoHeight / video.videoWidth);
        }
      };
      video.addEventListener('loadedmetadata', applyVideoRatio);
      applyVideoRatio();


      videoContainer.addEventListener('click', () => {
        video.muted = !video.muted;
        volumeIcon.classList.toggle('muted', video.muted);
        volumeIcon.classList.toggle('unmuted', !video.muted);

        if (!video.paused) return;
        video.play().catch(() => {});
      });

      const tryPlay = () => {
        video.play().catch((err) => console.warn('Replay blocked:', err));
        document.removeEventListener('touchstart', tryPlay);
      };

      tryPlay();
      document.addEventListener('touchstart', tryPlay);
    }

</script>


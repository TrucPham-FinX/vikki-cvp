    width: 100%;
  }

  .absolute-row {
    position: relative;
    top: -20px;
  }
  .relative-row {
    position: relative;
  }
  .show-detail-text {
    position: relative;
    cursor: pointer;
    bottom: 20vw;
    font-family: 'Be Vietnam Pro', sans-serif;
    left: 7vw;
    font-weight: 400;
    font-size: 6vw;
    line-height: 8vw;

  /* Pagination wrapper */
  swiper-container::part(pagination) {
    display: flex;
    align-items: center;
    gap: 7px;
    background: #f3f3f3;
    padding: 8px 9px;
    border-radius: 999px;
    width: fit-content;
    margin: 40px auto 0;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
  }

  .hide-pagination::part(pagination) {
    display: none;
  }
  .slide-container {
    padding-top: 3rem;
  }
  swiper-container::part(bullet) {
    width: 8px;
    height: 8px;
    background: #e0e0e0;
    border-radius: 50%;

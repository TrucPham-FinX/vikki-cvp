    text-decoration: underline;
    text-decoration-style: solid;
    color: #fff;
    text-decoration-thickness: 0%;
    text-decoration-skip-ink: auto;
  }

  /* video */
  #video-container {
    display: flex;
  }
  #banner-container {
    overflow: hidden;
  }

  #video-container,
  #section-1-cell,
  #section-3-cell {
    position: relative;
  }

  #banner-video {
    position: absolute;
    top: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  #volume-icon {
    position: absolute;
    width: auto;
    height: auto;
    top: 1vw;
    left: 1vw;
  }

  .fa-icon {
    font-size: 1.8rem;
    line-height: 1.8rem;
  }

  .muted .fa-icon.fa-volume-high {
    display: none;
  }

  .unmuted .fa-icon.fa-volume-xmark {
    display: none;
  }

  /* Real height instead of the old padding-bottom:177% hack — that hack's
     size is capped by nothing, so on wide viewports (e.g. a Galaxy Fold
     unfolded) it made the banner taller than the screen. --video-ar is set
     from each video's own real dimensions once it loads (see scripts.hbs),
     so this stays correct regardless of which video a page uses; 16/9 (the
     current videos' real height:width, 9:16 portrait) is only the fallback
     for the instant before that script runs. */
  #video-container {
    position: relative;
    padding-bottom: 0;
    height: calc(100vw * var(--video-ar, calc(16 / 9)));
  }

  /* Accodion */
  .accordion {
    max-width: 700px;
    margin: 0 auto;
    border-radius: 0;
    line-height: 1.5;
  }
  .accordion * {
    line-height: 22px;
  }
  .accordion ul {
    padding-left: 10px;
  }
  .accordion-section {
    background: rgb(240, 248, 233);
    padding: 1rem;
  }

  .accordion-item {
    background: #fff;
    box-shadow: 0px 0px 3px 0px rgba(0, 0, 0, 0.08);
    border-radius: 20px;
    margin-top: 1rem;
  }
  .accordion-item:first-child {
    margin-top: 0;
  }

  .accordion-header {
    width: 100%;
    padding: 16px 20px;
    background: none;
    border: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
    color: rgba(4, 11, 30, 0.92);
  }

  .accordion-header span {
    color: rgba(4, 11, 30, 0.92);
  }

  .accordion-header .icon {
    transition: transform 0.3s ease;
    transform: rotate(180deg);
  }

  .accordion-item.active .icon {
    transform: rotate(0deg);
  }

  .accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease;
    padding: 0 20px;
  }

  .accordion-item.active .accordion-content {
    padding-bottom: 16px;
  }

  .accordion-content p {
    margin: 12px 0;
    line-height: 1.6;
  }

  /* tooltip */
  .tooltip-wrapper {
    padding-left: 1rem;
    padding-right: 1rem;
    text-align: center;
    gap: 1rem;
  }

  .tooltip-title {
    width: 90%;
  }
  .tooltip-box {
    background: #000;
    color: #fff;
    padding: 12px 14px;
    border-radius: 8px;
    width: 100%;
    display: none;
    font-size: 13px;
    line-height: 1.5;
  }
    /* arrow */
  .arrow-up {
    width: 0;
    height: 0;
    border-left: 6px solid transparent;
    border-right: 6px solid transparent;
    border-bottom: 6px solid black;
    display: none;
    margin: 0 auto;
  }
  .tooltip-box::after {
    content: "";
    display: block;
    border-width: 6px;
    border-style: solid;
    border-color: transparent transparent #000 transparent;
  }
  .vikki_flexi_button {
    width: 25vw;
  }
  /* show tooltip */
  .tooltip-wrapper.active .tooltip-box {
    transition: opacity 0.5s ease;
    display: block;
  }
  .tooltip-wrapper.active .arrow-up {
    transition: opacity 0.5s ease;
    display: block;
  }
  .spinnerKichHoatNgay {
    width: 26px;
    height: 26px;
    border: 2px solid #ccc;
    border-top: 2px solid #0000FF;
    border-radius: 50%;
    animation: spin 2s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
  .loading-position {
    position: absolute;
    top: 53vw;
    right: 8vw;
  }
  /* overlay */
  .popup-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.6);
    transition: top 0.3s;
    z-index: 9999;
    top: 150%;
  }
  .hasTopSpace .popup-overlay.show {
    top: 25vw;
  }

  .popup-overlay.show {
    top:0;
  }
  .popup-overlay .popup-close{
    display: none;
  }
  .popup-overlay.show .popup-close{
    display: block;
  }

  .popup-content {
    background: rgba(246, 247, 248, 1);
    width: 100%;
    height: 100%;

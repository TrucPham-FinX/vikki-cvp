    padding: 0px 10px 50px;
  }

  /* slider */
  swiper-container {
    width: 100vw;
  }

  swiper-slide {
    padding: 15px;
    margin-bottom: 15px;
  }
  .slide-img {
    width: 100%;
  }
  .slide-img > span{
    background: rgba(0, 0, 0, 0.04);
    border-radius: 10%;
    overflow: hidden;
  }

  .slide-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .swiper-slide-next {
    left: -5vw;
    z-index: 1;
    animation-name: showNextSlide;
    animation-duration: 0.5s;
  }
  .swiper-pagination {
    background-color: red;
  }
  @keyframes showNextSlide {
    0% {
      left: 0%;
    }

    100% {
      left: -5vw;
    }
  }

  .swiper-img {
    object-fit: cover;
    width: 100%;
    height: 100%;
  }


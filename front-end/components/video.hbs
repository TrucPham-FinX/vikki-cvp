<div id='banner-container'>
  <div id='video-container'>
    <video
      id='banner-video'
      src='./assets/video.mp4'
      poster='./assets/poster.jpg'
      autoplay
      playsinline
      preload='auto'
      muted
      loop
      webkit-playsinline
      class='banner-video'
    ></video>
    <button id='volume-icon' class='volume-icon muted'>
      <img src='./assets/icon-unmuted.svg' class='fa-icon fa-volume-high' />
      <img src='./assets/icon-muted.svg' class='fa-icon fa-volume-xmark' />
    </button>
  </div>
</div>
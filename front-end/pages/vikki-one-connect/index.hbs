}


</style>
<button class='btn-register' id="btnRegister">Mở thẻ ngay</button>

<script>
    const paramCards = new URLSearchParams(window.location.search);
    const hasCard = paramCards.get('hasCard');

    if (hasCard && hasCard === 'true') {
      body.classList.add('hasCard');
    }

  document.addEventListener("DOMContentLoaded", () => {
    const params = new URLSearchParams(window.location.search);
    const productSchemeParam = params.get("productScheme");
    let orgSchema = productSchemeParam ? productSchemeParam.toUpperCase() : 'HDBANK';

    function mapOrg(orgSchema) {
      if (!orgSchema) return null;
      if (orgSchema.includes("HDBANK")) return "hdbank";
      if (orgSchema.includes("VIKKI_BANK") || orgSchema.includes("VIKKI")) return "vikki";
      if (orgSchema.includes("SOVICO")) return "sovico";
      if (orgSchema.includes("DAMTC")) return "damtc";
      return null;
    }

    if (orgSchema) {
      document.querySelectorAll(".partner-item").forEach(item => {
        const id = item.getAttribute("data-id");
       
        if (id === mapOrg(orgSchema)) {
          
          item.classList.add("is-primary");
        } else {
          item.classList.remove("is-primary");
        }
      });
    }
  });

</script>

<script>
    document.getElementById('btnRegister').addEventListener('click', function () {
    const payload = {
      action: 'OPEN_CARD'
    };

    if (window.ReactNativeWebView) {
      window.ReactNativeWebView.postMessage(JSON.stringify(payload));
    }
  });

  document.addEventListener('click', (e) => {
    const item = e.target.closest('.partner-item');
    if (!item) return;

    const paramCards = new URLSearchParams(window.location.search);
    const hasCard = paramCards.get('hasCard');
    const link = item.dataset.link;
    const id = item.dataset.id;
    
    if (window.ReactNativeWebView && (!hasCard || hasCard === 'false' ) && (id === 'hdbank' || id === 'sovico' || id === 'vikki' || id === 'vikkibank')) {
        window.ReactNativeWebView.postMessage(
        JSON.stringify({
            action: 'OPEN_CARD'
        })
        );
        return;
    }
  })
 
</script>

{{> safePlusOverview}}

{{!-- Configure only Safe Plus sliders before the shared Swiper initializer runs. --}}
<script>
  window.addEventListener('load', () => {
    const heroVideo = document.getElementById('safe-plus-hero-video');
    const volumeButton = document.getElementById('safe-plus-volume-icon');

    if (!heroVideo) return;

    const hlsSrc = '{{videoHlsSrc}}';
    const mp4Src = '{{videoSrc}}';

    if (heroVideo.canPlayType('application/vnd.apple.mpegurl')) {
      heroVideo.src = hlsSrc;
    } else if (window.Hls && Hls.isSupported()) {
      const safePlusHls = new Hls();
      safePlusHls.loadSource(hlsSrc);
      safePlusHls.attachMedia(heroVideo);
      safePlusHls.on(Hls.Events.ERROR, (_event, data) => {
        if (!data.fatal) return;
        safePlusHls.destroy();
        heroVideo.src = mp4Src;
        heroVideo.play().catch(() => {});
      });
    }

    heroVideo.play().catch(() => {});

    if (volumeButton) {
      volumeButton.addEventListener('click', () => {
        heroVideo.muted = !heroVideo.muted;
        volumeButton.classList.toggle('muted', heroVideo.muted);
        volumeButton.classList.toggle('unmuted', !heroVideo.muted);
        heroVideo.play().catch(() => {});
      });
    }
  });

  const safePlusAutoplay = {
    delay: 5000,
    disableOnInteraction: false,
    pauseOnMouseEnter: true
  };

  document
    .querySelectorAll('.safe-plans-slider .center-swiper, .safe-steps-slider .center-swiper')
    .forEach((swiper) => {
      Object.assign(swiper, {
        loop: false,
        rewind: true,
        autoplay: safePlusAutoplay
      });
    });

  window.addEventListener('load', () => {
    const registrationSlider = document.querySelector(
      '.safe-steps-slider .center-swiper'
    );

    if (!registrationSlider || !registrationSlider.swiper) return;

    registrationSlider.swiper.autoplay.stop();
    window.setTimeout(() => {
      registrationSlider.swiper.autoplay.start();
    }, 2500);
  });

  window.addEventListener('DOMContentLoaded', () => {
    const safePopup = document.getElementById('popup');
    const safePopupBody = document.getElementById('popupBody');
    let lockedScrollY = 0;
    let isPageScrollLocked = false;

    if (!safePopup || !safePopupBody) return;

    const lockPageScroll = () => {
      if (isPageScrollLocked) return;

      lockedScrollY = window.scrollY || window.pageYOffset;
      Object.assign(document.body.style, {
        position: 'fixed',
        top: `-${lockedScrollY}px`,
        left: '0',
        right: '0',
        width: '100%',
        overflow: 'hidden'
      });
      isPageScrollLocked = true;
    };

    const unlockPageScroll = () => {
      if (!isPageScrollLocked) return;

      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      document.body.style.overflow = '';
      window.scrollTo(0, lockedScrollY);
      isPageScrollLocked = false;
    };

    const syncPopupScroll = () => {
      const isOpen = safePopup.classList.contains('show');
      const hasIframe = Boolean(safePopupBody.querySelector('.popup-iframe'));

      document.body.classList.toggle('safe-popup-open', isOpen);

      safePopupBody.classList.toggle(
        'safe-popup-body--iframe',
        isOpen && hasIframe
      );
      safePopup.classList.toggle(
        'safe-popup--iframe',
        isOpen && hasIframe
      );

      if (isOpen) {
        lockPageScroll();
      } else {
        unlockPageScroll();
      }
    };

    new MutationObserver(syncPopupScroll).observe(safePopup, {
      attributes: true,
      attributeFilter: ['class']
    });

    safePopup.addEventListener('touchmove', (event) => {
      if (!event.target.closest('.popup-body')) {
        event.preventDefault();
      }
    }, { passive: false });
  });
</script>

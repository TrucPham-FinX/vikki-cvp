<style>
  body {
    display: flex;
    flex-direction: column;
  }

  .wording-brand {
    order: -1;
  }

  .wording-front-pages {
    order: -1;
    margin: 12px 16px 0;
  }

  .wording-back-cover {
    margin: 12px 16px 0;
  }

  .wording-front-pages img,
  .wording-back-cover img {
    display: block;
    width: 100%;
    height: auto;
    margin-bottom: 16px;
  }

  .legal-small-title {
    display: none;
  }

  .wording-navigation {
    order: -2;
    padding: 8px 16px 0;
    background: #fff;
  }

  .legal-page {
    padding-top: 8px;
    padding-bottom: 0;
  }

  .legal-content {
    padding-bottom: 0;
  }

  .legal-content > .accordion:last-child {
    margin-bottom: 0;
  }

  /* The PDF cover pages already contain the document heading and branding. */
  .legal-page > .center,
  .legal-page > .legal-title {
    display: none;
  }

  .legal-content > .accordion > .accordion-header {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.5;
    padding: 16px 12px;
  }

  .legal-content > .accordion > .accordion-body > .accordion > .accordion-header {
    font-size: 16px;
    font-weight: 700;
    line-height: 1.5;
    text-transform: none;
    color: rgba(4, 11, 30, 0.92);
    padding: 16px 8px 8px;
  }

  .wording-subheading {
    font-size: 15px;
    padding-top: 12px;
  }

  .wording-paragraph strong {
    font-weight: 700;
  }

  .wording-paragraph {
    margin: 12px 0;
    line-height: 1.6;
    overflow-wrap: anywhere;
  }
  .wording-back-top {
    position: fixed;
    left: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom, 0px));
    z-index: 10;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 1px 4px rgba(0, 0, 0, .15);
    cursor: pointer;
  }

  .wording-back-top img {
    width: 100%;
    height: 100%;
  }
</style>
<nav class="wording-navigation" lang="{{uiLanguage}}" aria-label="{{backLabel}}">
  {{> backLink href="tc.html" label=backShortLabel ariaLabel=backLabel}}
</nav>
<div class="center wording-brand">
  <img src="{{header.img}}" alt="Vikki" />
</div>
<div class="wording-front-pages">
  {{#each frontPages}}
    <img src="{{src}}" alt="{{alt}}" width="{{width}}" height="{{height}}" />
  {{/each}}
</div>
{{#if backCover}}
<div class="wording-back-cover">
  <img src="{{backCover.src}}" alt="{{backCover.alt}}" width="{{backCover.width}}" height="{{backCover.height}}" loading="lazy" />
</div>
{{/if}}
<button class="wording-back-top" type="button" hidden lang="{{uiLanguage}}" aria-label="{{backTopLabel}}" title="{{backTopLabel}}">
  <img src="../assets/icon-btt.svg" alt="" />
</button>
<script>
  (() => {
    const button = document.querySelector('.wording-back-top');
    const updateVisibility = () => {
      button.hidden = window.scrollY <= 300;
    };
    window.addEventListener('scroll', updateVisibility, { passive: true });
    window.addEventListener('pageshow', updateVisibility);
    button.addEventListener('click', () => {
      document.querySelector('.wording-navigation a').focus({ preventScroll: true });
      window.scrollTo({
        top: 0,
        behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
      });
    });
    updateVisibility();
  })();
</script>

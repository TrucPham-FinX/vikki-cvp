  .vikki-golden-savings .accordion-group-heading {
    font-size: 14px;
    font-weight: 400;
    color: rgba(4, 11, 30, 0.6);
    padding: 20px 0 8px;
  }

  .vikki-golden-savings .accordion-group-heading:first-child {
    padding-top: 0;
  }

</style>
<script>
  const goldenSwiperOptions = {
    slidesPerView: 1.24,
    centeredSlides: true,
    spaceBetween: 12,
    pagination: true,
    loop: true,
    autoplay: {
      delay: 8000,
      disableOnInteraction: false
    }
  };

  const ensureGoldenLoopSlides = (swiper) => {
    if (swiper.dataset.goldenLoopReady === 'true') return;

    const slides = Array.from(swiper.children).filter((slide) => (
      slide.tagName.toLowerCase() === 'swiper-slide' && !slide.dataset.goldenClone
    ));

    if (!slides.length) return;

    slides.forEach((slide, index) => {
      slide.dataset.goldenSourceIndex = String(index);
    });

    for (let copy = 0; copy < 2; copy += 1) {
      slides.forEach((slide, index) => {
        const clone = slide.cloneNode(true);
        clone.dataset.goldenClone = 'true';
        clone.dataset.goldenSourceIndex = String(index);
        swiper.appendChild(clone);
      });
    }

    swiper.dataset.goldenLoopReady = 'true';
  };

  const configureGoldenSwiperBeforeInit = () => {
    document.querySelectorAll('.vikki-golden-savings .golden-slider .center-swiper').forEach((swiper) => {
      ensureGoldenLoopSlides(swiper);
      Object.assign(swiper, goldenSwiperOptions);
    });
  };

  configureGoldenSwiperBeforeInit();

  const goldenSwiperObserver = new MutationObserver(configureGoldenSwiperBeforeInit);

  if (document.body) {
    goldenSwiperObserver.observe(document.body, {
      childList: true,
      subtree: true
    });
  }

  customElements.whenDefined('swiper-container').then(() => {
    const SwiperContainer = customElements.get('swiper-container');
    const prototype = SwiperContainer?.prototype;

    if (!prototype || prototype.goldenSavingsPatched) return;

    const initialize = prototype.initialize;

    prototype.initialize = function (...args) {
      if (this.closest?.('.vikki-golden-savings .golden-slider')) {
        Object.assign(this, goldenSwiperOptions);
      }

      return initialize.apply(this, args);
    };

    prototype.goldenSavingsPatched = true;
  });

  window.addEventListener('DOMContentLoaded', () => {
    goldenSwiperObserver.disconnect();

    const setupGoldenPagination = (swiper, instance) => {
      if (swiper.dataset.goldenPaginationReady === 'true') return;

      const shadowStyle = document.createElement('style');
      shadowStyle.textContent = '.swiper-pagination { display: none !important; }';
      swiper.shadowRoot?.appendChild(shadowStyle);

      const paginationWrap = document.createElement('div');
      paginationWrap.className = 'golden-pagination-wrap';

      const pagination = document.createElement('div');
      pagination.className = 'golden-pagination';

      for (let index = 0; index < 4; index += 1) {
        const dot = document.createElement('span');
        dot.className = 'golden-pagination-dot';
        dot.setAttribute('aria-hidden', 'true');
        pagination.appendChild(dot);
      }

      paginationWrap.appendChild(pagination);
      swiper.insertAdjacentElement('afterend', paginationWrap);

      const updatePagination = () => {
        const dots = pagination.querySelectorAll('.golden-pagination-dot');

        const activeSlide = swiper.querySelector('swiper-slide.swiper-slide-active');
        const sourceIndex = Number(activeSlide?.dataset.goldenSourceIndex);
        const activeIndex = Number.isFinite(sourceIndex) ? sourceIndex : instance.realIndex % 4;

        dots.forEach((dot, index) => {
          const isActive = index === activeIndex;
          dot.classList.toggle('is-active', isActive);
          dot.setAttribute('aria-current', isActive ? 'true' : 'false');
        });
      };

      const schedulePaginationUpdate = () => {
        requestAnimationFrame(updatePagination);
        setTimeout(updatePagination, 50);
        setTimeout(updatePagination, 300);
      };

      instance.on('slideChange', schedulePaginationUpdate);
      instance.on('slideChangeTransitionEnd', schedulePaginationUpdate);
      updatePagination();
      requestAnimationFrame(updatePagination);
      setTimeout(updatePagination, 300);
      swiper.goldenPaginationTimer = setInterval(updatePagination, 250);

      swiper.dataset.goldenPaginationReady = 'true';
    };

    const startGoldenSwiperAutoSlide = () => {
      configureGoldenSwiperBeforeInit();

      document.querySelectorAll('.vikki-golden-savings .golden-slider .center-swiper').forEach((swiper) => {
        const instance = swiper.swiper;
        if (!instance) return;

        Object.assign(instance.params, goldenSwiperOptions);
        instance.update();
        instance.autoplay?.start();
        setupGoldenPagination(swiper, instance);
      });
    };

    requestAnimationFrame(startGoldenSwiperAutoSlide);
    setTimeout(startGoldenSwiperAutoSlide, 300);
    setTimeout(startGoldenSwiperAutoSlide, 1000);

    const popup = document.getElementById('popup');
    let lockedScrollY = 0;

    const lockPageScroll = () => {
      lockedScrollY = window.scrollY || window.pageYOffset;
      Object.assign(document.body.style, {
        position: 'fixed',
        top: `-${lockedScrollY}px`,
        left: '0',
        right: '0',
        width: '100%',
        overflow: 'hidden'
      });
    };

    const unlockPageScroll = () => {
      document.body.style.position = '';
      document.body.style.top = '';
      document.body.style.left = '';
      document.body.style.right = '';
      document.body.style.width = '';
      document.body.style.overflow = '';
      window.scrollTo(0, lockedScrollY);
    };

    if (popup) {
      const applyFaqPopupLayout = () => {
        const popupBody = document.getElementById('popupBody');
        if (!popupBody) return;

        const iframe = popupBody.querySelector('.popup-iframe');
        const isTermsOnline = iframe?.getAttribute('src')?.includes('/vikki-golden-savings/tc-online-2.html');
        popupBody.classList.toggle('popup-body--terms-online', Boolean(isTermsOnline));

        if (!popupBody.querySelector('.popup-inner')) return;
        const titleEl = popupBody.querySelector('.popup-title');
        if (titleEl && titleEl.parentElement !== popupBody) {
          popupBody.insertBefore(titleEl, popupBody.firstChild);
        }
        popupBody.classList.add('pt-50');
      };

      const syncPopupScrollLock = () => {
        if (popup.classList.contains('show')) {
          lockPageScroll();
          applyFaqPopupLayout();
        } else {
          unlockPageScroll();
        }
      };

      new MutationObserver(syncPopupScrollLock).observe(popup, {
        attributes: true,
        attributeFilter: ['class']
      });

      popup.addEventListener('touchmove', (event) => {
        if (!event.target.closest('.popup-body')) {
          event.preventDefault();
        }
      }, { passive: false });
    }

    // Use the stable section class so cache-busting asset filename changes do
    // not disable the Terms and FAQ hotspots.
    const stepsCell = document.querySelector('.vikki-golden-savings .golden-steps-cell')
      || document.querySelector('.vikki-golden-savings img[src$="p-2.png"]')?.parentElement;

    if (stepsCell && !stepsCell.querySelector('.two-golden-overlay')) {
      const twoGolden = document.createElement('img');
      twoGolden.src = './assets/two-golden.png';
      twoGolden.alt = '';
      twoGolden.className = 'two-golden-overlay';

      stepsCell.appendChild(twoGolden);
    }

    if (stepsCell && !stepsCell.querySelector('.golden-terms-hotspot')) {
      stepsCell.classList.add('golden-hotspot-cell');

      const termsHotspot = document.createElement('button');
      termsHotspot.type = 'button';
      termsHotspot.className = 'image-hotspot golden-terms-hotspot';
      termsHotspot.setAttribute('aria-label', 'Thể lệ');
      termsHotspot.addEventListener('click', () => {
        openPopup('/vikki-cvp/vikki-golden-savings/tc-2.html', 'Thể lệ');
      });

      stepsCell.appendChild(termsHotspot);
    }

    if (stepsCell && !stepsCell.querySelector('.golden-faq-hotspot')) {
      stepsCell.classList.add('golden-hotspot-cell');

      const faqHotspot = document.createElement('button');
      faqHotspot.type = 'button';
      faqHotspot.className = 'image-hotspot golden-faq-hotspot';
      faqHotspot.setAttribute('aria-label', 'Hỏi đáp');
      faqHotspot.addEventListener('click', () => {
        const faqSection = document.querySelector('.vikki-golden-savings img[src*="cau-hoi-thuong-gap"]');
        if (faqSection) {
          faqSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      });

      stepsCell.appendChild(faqHotspot);
    }

    const qaGroups = {{{json qaGroups}}};
    if (Array.isArray(qaGroups) && qaGroups.length) {
      const faqContainer = document.querySelector('.vikki-golden-savings .container.px-1');
      const mainAccordion = faqContainer?.querySelector('.js-accordion');
      if (mainAccordion) {
        const items = Array.from(mainAccordion.querySelectorAll(':scope > .accordion-item'));
        let cursor = 0;
        qaGroups.forEach((group) => {
          if (cursor < items.length) {
            const heading = document.createElement('div');
            heading.className = 'accordion-group-heading';
            heading.textContent = group.title;
            items[cursor].before(heading);
            cursor += group.count;
          }
        });
      }
    }

  });
</script>

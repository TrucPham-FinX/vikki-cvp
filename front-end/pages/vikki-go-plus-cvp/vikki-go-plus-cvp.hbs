        </span>
      </span>
    </div>
    <div>
      <span data-title="Ưu đãi" data-popup='/vikki-cvp/promotion/list.html?category=VIKKIGO_PLUS'>
        <img src='./assets/offer.svg' />
        <span>
          Ưu đãi
        </span>
      </span>
    </div>
  </div>
</div>


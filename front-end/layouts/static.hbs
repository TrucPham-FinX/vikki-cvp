<!DOCTYPE html>
<html lang="{{#if htmlLanguage}}{{htmlLanguage}}{{else}}vi{{/if}}">
  <head>
    <meta charset="UTF-8" />
    <title>{{title}}</title>
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <link rel='preconnect' href='https://fonts.googleapis.com' />
    <link rel='preconnect' href='https://fonts.gstatic.com' crossorigin />
    <link
      href='https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,400;0,500;0,600;0,700&display=swap'
      rel='stylesheet'
    />
    <style>
      body {
        font-family: 'Be Vietnam Pro', sans-serif;
        padding: 0;
        margin: 0;
        font-size: 16px;
        color: rgba(4, 11, 30, 0.92);
      }
      .legal-page {
        padding: 16px;
        line-height: 135%;
        padding-top: 20px;
      }
      .legal-content > .accordion {
        box-shadow: 0px 0px 3px 0px rgba(0, 0, 0, 0.08);
        border-radius: 20px;
        margin-bottom: 20px;
        background: #FFF;
        overflow: hidden;
      }
      .legal-content > .accordion > .accordion-header {
        background: rgba(232, 241, 255, 1);
        font-weight: 600;
        font-size: 17px;
      }
      .accordion-body {
        font-size: 14px;
        padding: 0 5px;
      }
      .accordion-header {
        font-size: 16px;
        padding: 12px 8px;
        text-transform: uppercase;
        cursor: pointer;
        color:  rgba(0, 0, 255, 1);
        line-height: 22px;
      }
      .article .accordion-header {
        background: #fff;
        border: 1px solid #ddd;
      }
      .legal-list {
        margin: 8px 0 12px 6px;
        padding: 0;
      }
      .legal-list-item {
        margin-bottom: 6px;
        margin-left: 15px;
      }
      .legal-list-text {
        display: inline;
        line-height: 1.6;
      }

      /* ===== Marker styles ===== */
      .legal-list.numeric,
      .legal-list.decimal {
        list-style-type: decimal;
      }
      .legal-list.alpha {
        list-style-type: lower-alpha;
      }
      .legal-list.roman {
        list-style-type: lower-roman;
      }
      .legal-list.disc {
        list-style-type: disc;
      }
      .legal-list.none {
        list-style-type: none;
        margin-left: 0;
      }
      .legal-title {
        font-size: 20px;
        color: rgba(0, 0, 255, 1);
        text-transform: uppercase;
        text-align: center;
      }
      .center {
        text-align: center;
        padding-top:20px;
      }
      .center img {
        width: 85px;
      }
      .legal-small-title {
        font-size: 16px;
        font-weight: 600;
      }
      thead {
        background: rgba(0, 72, 255, 1);
        color: #fff;
      }
      thead th {
        font-weight: normal;
        font-size: 12px;
      }
      .bg-blue {
        background: rgba(237, 248, 255, 1);
      }
      tbody td {
        font-size: 14px;
        color: rgba(1, 5, 15, 1);
      }
      tbody td,
      table {
        border-collapse: collapse;
        border: 1px solid #dfdfdf;
        min-width: 100%;
        table-layout: fixed;
      }
      table th:first-child,
      table td:first-child {
        width: 40px;
      }
      thead th,
      tbody td {
        max-width: 150px;
        padding: 8px;
      }
      .scroll-x {
        overflow-x: auto;
      }
      .auto-table {
        table-layout: auto;
        width: auto;
        border-collapse: collapse;
      }
      .auto-table {
        width: 700px;
      }
      thead th {
        border: 1px solid #fff;
      }
      .m-w-100 {
        min-width: 100px;
      }
      .fz-14 {
        font-size: 14px;
      }
      .p-8 {
        padding: 8px;
      }
      .table-scroll {
        width: 100%;
        overflow-x: auto;
      }
      .fee-table {
        min-width: 100%;
        width: max-content;
        border-collapse: collapse;
      }
      .w-150 {
        width: 150px;
      }
      .legal-note {
        font-size: 1rem;
        padding: 0;
        padding-top: 8px;
        padding-bottom: 8px;
      }
      .legal-footer {
        text-align: right;
        font-weight: 600;
        font-size: 1rem;
        padding: 8px;
      }
      .legal-content {
        padding-bottom: 120px;
      }
      .w-unset {
        width: unset !important;
      }
      .bold{
        font-weight: bold;
      }
      .bold-center{
        font-weight: bold;
        text-align: center;
      }
      .w-150-f {
        width: 150px !important;
      }
      .no-list-style {
        list-style-type: none;
        margin-left: 0;
        padding-left: 0;
      }
    </style>
  </head>
  <body>
    <div class="legal-page">
      <span class="legal-small-title">{{#if (eq language "en")}}Terms and Conditions{{else}}Điều khoản và Điều kiện{{/if}}</span>
      <div class="center"><img src="{{#if useHeaderImage}}{{header.img}}{{else}}assets/vikki-logo.png{{/if}}" alt="Vikki" /></div>
      <h1 class="legal-title">{{header.h1}}</h1>

      {{#each header.intro}}
        <p class="legal-intro">{{this}}</p>
      {{/each}}

      <div class="legal-layout">
        {{!-- {{> static/toc }} --}}

        <main class="legal-content">
          {{#each sections}}
            {{> static/section }}
          {{/each}}
          {{#if note}}
            <div class="legal-note">
              {{note.text}}
            </div>
          {{/if}}
          {{#if footer}}
            <div class="legal-footer">
              {{footer.h1}}
            </div>
          {{/if}}
        </main>
      </div>
    </div>
    {{{body}}}
    <script>
      function toggle(id) {
        const el = document.getElementById(id)
        if (!el) return
        el.style.display = el.style.display === 'none' ? 'block' : 'none'
      }
    </script>
  </body>
</html>

{
  "name": "vikki-cvp-admin",
  "version": "0.1.0",
  "private": true,
  "description": "Admin for the Vikki CVP pages: Payload CMS over front-end/data, published through the Handlebars build",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3200",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3200",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "typecheck": "tsc --noEmit",
    "cvp:roundtrip": "tsx src/cvp/scripts/roundtrip.ts",
    "cvp:import": "cross-env NODE_OPTIONS=--no-deprecation payload run src/cvp/scripts/import.ts",
    "cvp:export": "cross-env NODE_OPTIONS=--no-deprecation payload run src/cvp/scripts/export.ts",
    "cvp:media:import": "cross-env NODE_OPTIONS=--no-deprecation payload run src/cvp/scripts/media-import.ts",
    "cvp:roundtrip:db": "cross-env NODE_OPTIONS=--no-deprecation payload run src/cvp/scripts/roundtrip-db.ts",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/credential-provider-http": "^3.972.83",
    "@aws-sdk/credential-provider-web-identity": "^3.972.87",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/plugin-cloud-storage": "3.92.1",
    "@payloadcms/storage-s3": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "cross-env": "^7.0.3",
    "graphql": "^16.8.1",
    "next": "16.4.1",
    "payload": "3.92.1",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "sass": "1.77.4",
    "tsx": "4.23.15",
    "typescript": "5.7.3",
    "vitest": "3.2.7"
  },
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  }
}

# Copy to .env and replace every change-me value. Generate secrets with `openssl rand -hex 32`.

PAYLOAD_SECRET=change-me
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3200

# Postgres from docker-compose.yml (127.0.0.1:54391)
DATABASE_NAME=cvp_admin
DATABASE_USERNAME=cvp_admin
DATABASE_PASSWORD=change-me
DATABASE_PORT=54391
DATABASE_URL=postgres://cvp_admin:change-me@127.0.0.1:54391/cvp_admin

# The vikki-cvp checkout the admin reads front-end/ from and publishes into. Default: the folder
# above this one.
# CVP_REPO_ROOT=

# ─── Media library storage (src/cvp/storage.ts) ─────────────────────────
# Same variables and credential order as galaxy-g-digital-center (src/services/storage.ts).
# Empty AWS_S3_BUCKET = files kept in admin/media/. Keys: media/<owner>/cvp/<page>/<folder>/<file>.
AWS_S3_BUCKET=            # empty = admin/media
AWS_S3_REGION=
AWS_S3_ENDPOINT_URL=      # only for MinIO, R2, …
AWS_S3_FORCE_PATH_STYLE=  # empty = on when an endpoint is set
AWS_S3_ACL=               # empty with AWS
AWS_S3_MEDIA_OWNER=       # platform | tenant/<slug>; empty = platform
AWS_S3_SIGNED_URL_TTL=    # seconds, 30..3600; empty = 300
# A pod with an IAM role (IRSA / Pod Identity) uses the role; the pair below is then only a fallback.
AWS_ACCESS_KEY_ID=        # no role: set both or neither
AWS_SECRET_ACCESS_KEY=

{
  "name": "vikki-cvp",
  "version": "1.0.0",
  "private": true,
  "description": "Vikki CVP landing pages generator and content repository",
  "scripts": {
    "build": "npm run --prefix front-end build",
    "check": "npm run --prefix front-end check",
    "dev": "npm run --prefix front-end dev",
    "validate": "node core/validate.js",
    "lint:content": "node core/validate.js --lint",
    "inventory": "node core/inventory.js",
    "manifest": "node core/manifest.js",
    "manifest:verify": "node core/manifest.js --verify",
    "manifest:orphans": "node core/manifest.js --check-orphans",
    "import:promotions": "node tools/import-promotions.js",
    "catalogue": "node tools/catalogue.js",
    "test:roadmap": "node tools/verify-roadmap.js",
    "publish:env": "node core/publish.js",
    "spike:engine": "node tools/spike-template-engine.js",
    "cvp": "node bin/cvp.js",
    "install:all": "npm install && npm install --prefix front-end"
  },
  "bin": {
    "cvp": "./bin/cvp.js"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "handlebars": "^4.7.10",
    "xlsx": "^0.18.5"
  }
}
